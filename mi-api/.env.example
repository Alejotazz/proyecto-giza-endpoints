PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ia_prediccion_cultivos
DB_POOL_LIMIT=10

# Generar uno propio con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto
JWT_EXPIRES_IN=8h

# Opcionales
# --- Producción (Aiven + Render): ver DESPLIEGUE.md ---
# DB_SSL=true                         # Aiven exige SSL; en XAMPP déjalo comentado
# DB_SSL_CA_PATH=/etc/secrets/ca.pem  # ruta del certificado CA de Aiven (Render: Secret Files)
# DB_SSL_CA=...                       # o el texto del certificado (si va en una línea, separa con \n)
# TRUST_PROXY=1                       # en Render, para que el límite de intentos vea la IP real
# CORS_ORIGINS=https://tu-app.vercel.app
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AUTH_RATE_LIMIT=20
# ROLES=administrador,agricultor,agronomo,investigador,empresa
